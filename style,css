
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Trebuchet MS", Arial, sans-serif;
  background: linear-gradient(135deg, #ffe0eb, #e8ddff, #fff0d9);
  color: #79536d;
}

.game {
  width: 100%;
  max-width: 480px;
  padding: 25px;
  text-align: center;
  background: #fffafd;
  border: 3px solid white;
  border-radius: 28px;
  box-shadow: 0 12px 35px #b879a52b;
}

.flowers {
  font-size: 25px;
  letter-spacing: 8px;
}

h1 {
  color: #d96c9c;
  margin: 12px 0 6px;
  font-size: 32px;
}

.subtitle {
  color: #a58aa9;
  margin-bottom: 22px;
}

.stats {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 22px;
}

.stats div {
  flex: 1;
  padding: 11px 4px;
  border-radius: 15px;
  background: #ffedf5;
  font-size: 12px;
  font-weight: bold;
}

.stats span {
  display: block;
  margin-top: 5px;
  font-size: 21px;
  color: #d96c9c;
}

.board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  padding: 18px 10px;
  border-radius: 22px;
  background: #e5f3d9;
}

.hole {
  aspect-ratio: 1;
  min-width: 0;
  border: none;
  border-radius: 50%;
  background: #a7cc8a;
  box-shadow: inset 0 -7px 0 #85b66b;
  font-size: 40px;
  cursor: pointer;
  transition: transform 0.12s;
  touch-action: manipulation;
}

.hole:active {
  transform: scale(0.92);
}

.hole.mole {
  background: #f8d8e8;
  box-shadow: inset 0 -5px 0 #e9b4d0;
  animation: pop 0.16s ease-out;
}

@keyframes pop {
  from {
    transform: scale(0.65);
  }
  to {
    transform: scale(1);
  }
}

#message {
  min-height: 24px;
  margin: 18px 0;
  font-size: 14px;
}

#startBtn {
  padding: 13px 28px;
  border: none;
  border-radius: 25px;
  background: #e995ba;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

#startBtn:hover {
  background: #d978a5;
}

@media (max-width: 380px) {
  .game {
    padding: 16px;
  }

  .board {
    gap: 10px;
    padding: 12px 7px;
  }

  .hole {
    font-size: 32px;
  }

  h1 {
    font-size: 27px;
  }
}
