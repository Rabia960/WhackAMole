rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player per level, id = <playerId>_<level>
    match /scores/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'level', 'best', 't'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 14
        && request.resource.data.level in ['easy', 'medium', 'hard']
        && docId.matches('.*_' + request.resource.data.level)
        && request.resource.data.best is int
        && request.resource.data.best >= 0
        && request.resource.data.best <= 500
        && request.resource.data.t is number
        // a score can only go up, never down
        && (resource == null || request.resource.data.best >= resource.data.best);
      allow delete: if false;
    }
  }
}
